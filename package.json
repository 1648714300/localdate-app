{
  "name": "localdate-app",
  "version": "1.0.0",
  "private": true,
  "description": "LocalDate 约会方案生成器 - 离线优先的跨平台移动应用",
  "scripts": {
    "build:data": "python scripts/build_data.py",
    "build:assets": "python scripts/make_assets.py",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "sync": "npx cap sync",
    "dev": "npx cap serve"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1"
  }
}
